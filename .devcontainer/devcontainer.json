{
  "name": "Rust",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {},
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "openai.chatgpt"
      ],
      "settings": {
        "rust-analyzer.cargo.buildScripts.enable": true,
        "rust-analyzer.procMacro.enable": true
      }
    }
  },
  "mounts": [
    "source=/lib/modules,target=/lib/modules,type=bind,readonly",
    "source=/usr/src,target=/usr/src,type=bind,readonly",
    "source=${localEnv:HOME}/.codex,target=/home/vscode/.codex,type=bind"
  ],
  "remoteUser": "vscode",
  "updateRemoteUserUID": false,
  "postCreateCommand": "rustup component add rustfmt clippy rust-src"
}
